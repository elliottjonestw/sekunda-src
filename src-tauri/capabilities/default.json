{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "//": "Binary writes, for saving a mail attachment. Same scopes as the text form: a path the user picked in the native save dialog, under their own directories.",
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.open-meteo.com/*" },
        { "url": "https://geocoding-api.open-meteo.com/*" },
        { "url": "https://air-quality-api.open-meteo.com/*" },
        { "url": "https://query1.finance.yahoo.com/*" },
        { "url": "https://caldav.icloud.com/*" },
        { "url": "https://*.icloud.com/*" },
        { "url": "https://secondbrain-api-staging.elliottj.workers.dev/*" },
        { "url": "https://secondbrain-api.elliottj.workers.dev/*" }
      ]
    }
  ]
}
